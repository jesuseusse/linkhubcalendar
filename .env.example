# ─────────────────────────────────────────────
# Firebase Client (public — exposed to the browser)
# ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ─────────────────────────────────────────────
# Firebase Admin (server-only — never exposed to the browser)
# ─────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Private key from the service account JSON. Keep newlines escaped as \n.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgk...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────
# Multi-tenant routing
# ─────────────────────────────────────────────
# The root domain of the platform (used by the proxy to distinguish tenant subdomains from the main site)
NEXT_PUBLIC_DOMAIN=linkhub.dev

# Fallback tenant hostname used when running locally (localhost / 127.0.0.1 / Amplify preview URLs)
NEXT_PUBLIC_DEFAULT_TENANT_HOSTNAME=yourtenant.com

# ─────────────────────────────────────────────
# Super admin
# ─────────────────────────────────────────────
# Comma-separated list of emails that have access to the super admin console (/dashboard/console/hub)
NEXT_SUPER_ADMINS_EMAILS=admin@example.com,another@example.com

# ─────────────────────────────────────────────
# Stripe webhook alerts
# ─────────────────────────────────────────────
# Comma-separated list of emails notified when a Stripe webhook event fails to process
# (e.g. price ID mismatch, user not found). Sent via the affected tenant's own email
# service (Resend/SES) — see /api/stripe/webhook. Leave unset to disable alert emails.
NEXT_STRIPE_ALERT_EMAILS=ops@example.com
