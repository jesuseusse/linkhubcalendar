rules_version = '2';

// All Firestore access in this application goes through Next.js API routes
// using the Firebase Admin SDK, which bypasses these security rules.
// The client-side Firebase SDK only initialises Firebase Auth (no Firestore client).
// These rules deny all direct client SDK access as a defence-in-depth measure,
// preventing any accidental exposure if a client-side Firestore reference were ever
// introduced.
//
// Data model:
//   tenant_registry/{hostname}                          – tenant config (theme, keys, SEO)
//     └─ stripe_events/{eventId}                       – Stripe idempotency log
//   tenants/{tenantId}/users/{userId}                   – user profiles per tenant
//     ├─ appointments/{docId}  (type:"slot"|"appointment") – calendar slots & bookings
//     └─ leads/{docId}                                  – contact-form leads

service cloud.firestore {
  match /databases/{database}/documents {

    // tenant_registry — contains sensitive Stripe & email credentials.
    // Never readable or writable by clients.
    match /tenant_registry/{hostname} {
      allow read, write: if false;

      match /stripe_events/{eventId} {
        allow read, write: if false;
      }
    }

    // tenants/{tenantId}/users — user profiles, links, theme, subscription state.
    // Sensitive fields (stripeSubscriptionId, plan, etc.) must never be client-writable.
    match /tenants/{tenantId}/users/{userId} {
      allow read, write: if false;

      // appointments subcollection — holds both calendar slots (type:"slot")
      // and booked appointments (type:"appointment").
      // Atomic booking/release operations use server-side transactions.
      match /appointments/{docId} {
        allow read, write: if false;
      }

      // leads — contact-form submissions captured server-side.
      match /leads/{docId} {
        allow read, write: if false;
      }
    }

    // Catch-all: deny any collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
